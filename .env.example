# Auth0 — create a free account at https://auth0.com
# Create an API with identifier "https://trading-journal-api"
# Create a SPA application and get the domain + client ID
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://trading-journal-api
AUTH0_CLIENT_ID=your-spa-client-id

# Anthropic — required for AI chart scoring. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter — required for AI trade chat. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-...

# Your own email address — gives you access to seed/delete buttons in the app
ADMIN_EMAIL=your-email@example.com
